# ==============================================================================
# Google Search Console (GSC) & Google Analytics 4 (GA4) Configuration
# ==============================================================================

# Google Search Console HTML Meta Verification String
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code-here

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Cloudinary Cloud Name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# ==============================================================================
# Nodemailer SMTP Email Credentials (Required for form emails)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ==============================================================================
# Razorpay Payment Gateway (For Yoga Anatomy Masterclass ₹99 checkout)
# ==============================================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==============================================================================
# Zoom Masterclass Credentials (Configured dynamically in Vercel)
# ==============================================================================
ZOOM_MEETING_ID=your_zoom_meeting_id
ZOOM_PASSCODE=your_zoom_passcode
ZOOM_LINK=https://us06web.zoom.us/j/your_meeting_id?pwd=your_password
WHATSAPP_SUPPORT_PHONE=91XXXXXXXXXX
